@{
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="container-div">
    <div class="row">
        <div id="searchDiv" class="col-sm-12 search-collapse">
            <div class="select-list">
                <ul>
                                       
                    <li>
                        预约状态：<span id="approvedStatus" col="ApprovedStatus"></span>
                    </li>
                    <li>
                        <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="btn-group-sm hidden-xs" id="toolbar">
            <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a>
            <a id="btnEdit" class="btn btn-primary disabled" onclick="showSaveForm(false)"><i class="fa fa-edit"></i> 修改</a>
            @* <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteForm()"><i class="fa fa-remove"></i> 删除</a> *@
            @* <a id="btnImport" class="btn btn-info" onclick="importForm()"><i class="fa fa-upload"></i> 导入</a> *@
            <a id="btnExport" class="btn btn-warning" onclick="exportForm()"><i class="fa fa-download"></i> 导出</a>

        </div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        initGrid();

        $("#appointmentStatus").ysComboBox({ data: ys.getJson(@Html.Raw(typeof(AppointmentStatusEnum).EnumToDictionaryString())) });
        laydate.render({ elem: '#startTime', format: 'yyyy-MM-dd' });
        laydate.render({ elem: '#endTime', format: 'yyyy-MM-dd' });
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/InfoManage/Appointment/GetPageListJson")';
        $('#gridTable').ysTable({
            url: queryUrl,
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'SupplierName', title: '供应商' },
                { field: 'ConsigneeName', title: '货主' },
                { field: 'CargoName', title: '货物名称' ,sortable: true },
                {
					field: 'CargoType', title: '类型',
                    formatter: function (value, row, index) {
                        if (row.CargoType == "@CargoTypeEnum.Common.ParseToInt()") {
                            return   "@CargoTypeEnum.Common.GetDescription()";                        
                        }else {
                            return "@CargoTypeEnum.Danger.GetDescription()";
                        }
                    }
                },

                { field: 'CargoWeight', title: '重量' },
                {
                    field: 'WeightUnit', title: '单位' ,
                    formatter: function (value, row, index) {
                        if (row.WeightUnit == "@WeightUnitEnum.Tons.ParseToInt()") {
                            return   "@WeightUnitEnum.Tons.GetDescription()";
                        } else if (row.WeightUnit == "@WeightUnitEnum.Kilograms.ParseToInt()") {
                            return "@WeightUnitEnum.Kilograms.GetDescription()";
                        }else {
                            return "@WeightUnitEnum.grams.GetDescription()";
                        }
                    }
                },
                
                { field: 'Volume', title: '体积' },
                { field: 'ArrivalDate', title: '到达日期'},
                {
					field: 'ArrivalTime', title: '到达时间',
					formatter: function (value, row, index) {
						if (row.ArrivalTime == "@ArrivalTimeEnum.Morning.ParseToInt()") {
                            return  '<span class="badge badge-primary">' + "@ArrivalTimeEnum.Morning.GetDescription()" + '</span>';
						}else if (row.ArrivalTime == "@ArrivalTimeEnum.Afternoon.ParseToInt()") {
                            return '<span class="badge badge-warning">' + "@ArrivalTimeEnum.Afternoon.GetDescription()" + '</span>';
						}else {
                            return '<span class="badge badge-info">' + "@ArrivalTimeEnum.Evening.GetDescription()" + '</span>';
						}
					}
                },
                
                {
                    field: 'AppointmentStatus', title: '状态',
                    formatter: function (value, row, index) {
                        if (row.AppointmentStatus == "@AppointmentStatusEnum.Submitted.ParseToInt()") {
                            return '<span class="badge badge-primary">' + "@AppointmentStatusEnum.Submitted.GetDescription()" + '</span>';
                        } else if (row.AppointmentStatus == "@AppointmentStatusEnum.Agreed.ParseToInt()") {
                            return '<span class="badge badge-sencondry">' + "@AppointmentStatusEnum.Agreed.GetDescription()" + '</span>';
                        }else if (row.AppointmentStatus == "@AppointmentStatusEnum.Rejected.ParseToInt()") {
                            return '<span class="badge badge-danger">' + "@AppointmentStatusEnum.Rejected.GetDescription()" + '</span>';
                        }else if (row.AppointmentStatus == "@AppointmentStatusEnum.Accepted.ParseToInt()") {
                            return '<span class="badge badge-success">' + "@AppointmentStatusEnum.Accepted.GetDescription()" + '</span>';
                        }else {
                            return '<span class="badge badge-warning">' + "@AppointmentStatusEnum.Unaccepted.GetDescription()" + '</span>';
                        }
                    }
                },
                {
                    field: 'BaseCreateTime', title: '创建时间',  visible: false, 
                    formatter: function (value, row, index) {
                        return ys.formatDate(value, "yyyy-MM-dd HH:mm:ss");
                    }
                }
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }

    function searchGrid() {
        $('#gridTable').ysTable('search');
        resetToolbarStatus();
    }

    function showSaveForm(bAdd) {
        var id = 0;
        if (!bAdd) {
            var selectedRow = $('#gridTable').bootstrapTable('getSelections');
            if (!ys.checkRowEdit(selectedRow)) {
                return;
            }
            else {
                id = selectedRow[0].Id;
            }
        }
        ys.openDialog({
            title: id > 0 ? '编辑' : '添加',
            content: '@Url.Content("~/InfoManage/Appointment/AppointmentForm")' + '?id=' + id,
            // width: '768px',
            // height: '550px',
            callback: function (index, layero) {
                var iframeWin = window[layero.find('iframe')[0]['name']];
                iframeWin.saveForm(index);
            }
        });
    }

    function deleteForm() {
        var selectedRow = $('#gridTable').bootstrapTable('getSelections');
        if (ys.checkRowDelete(selectedRow)) {
            ys.confirm('确认要删除选中的' + selectedRow.length + '条数据吗？', function () {
                var ids = ys.getIds(selectedRow);
                ys.ajax({
                    url: '@Url.Content("~/InfoManage/Appointment/DeleteFormJson")' + '?ids=' + ids,
                    type: 'post',
                    error: ys.ajaxError,
                    success: function (obj) {
                        if (obj.Tag == 1) {
                            ys.msgSuccess(obj.Message);
                            searchGrid();
                        }
                        else {
                            ys.msgError(obj.Message);
                        }
                    }
                });
            });
        }
    }

    function exportForm() {
        var url = '@Url.Content("~/InfoManage/Appointment/ExportAppointmentJson")';
        var postData = $("#searchDiv").getWebControls();
        ys.exportExcel(url, postData);
    }

    // function importForm() {
    //   ys.openDialog({
    //         title: "导入用户数据",
    //         content: '@Url.Content("~/InfoManage/Appointment/AppointmentImport")',
    //         height: "280px",
    //         callback: function (index, layero) {
    //             var iframeWin = window[layero.find('iframe')[0]['name']];
    //             iframeWin.saveForm(index);
    //         }
    //     });
    // }
</script>
