@{
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="container-div">
    <div class="row">
        <div id="searchDiv" class="col-sm-12 search-collapse">
            <div class="select-list">
                <ul>
                    <li>
                        审批状态：<span id="approvedStatus" col="ApprovedStatus"></span>
                    </li>
                    <li>
                        <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="btn-group-sm hidden-xs" id="toolbar">
            <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a> 
            <a id="btnEdit" class="btn btn-primary disabled" onclick="showSaveForm(false)"><i class="fa fa-edit"></i> 修改</a> 
            <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteForm()"><i class="fa fa-remove"></i> 删除</a>
        </div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        initGrid();

         $("#approvedStatus").ysComboBox({ data: ys.getJson(@Html.Raw(typeof(ApprovedStatusEnum).EnumToDictionaryString())) });
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/InfoManage/AppointmentRecord/GetPageListJson")';
        $('#gridTable').ysTable({
            url: queryUrl,
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'CurrentNodeCode', title: '当前节点编码' },
                { field: 'CurrentNodeName', title: '当前节点名称' },
                { field: 'OperatorId', title: '操作者Id' },
                { field: 'OperatorName', title: '操作者名称' },
                { 
                    field: 'ResultStatus', title: '审批结果' ,
                    formatter: function (value, row, index) {
                        if (row.ResultStatus == "@ResultStatusEnum.Agreed.ParseToInt()") {
                            return '<span class="badge badge-primary">' + "@ResultStatusEnum.Agreed.GetDescription()" + '</span>';
                        } else if (row.ResultStatus == "@ResultStatusEnum.Rejected.ParseToInt()"){
                            return '<span class="badge badge-warning">' + "@ResultStatusEnum.Rejected.GetDescription()" + '</span>';
                        }else {
							return '<span class="badge badge-secondary">' + "@ResultStatusEnum.Unprocessed.GetDescription()" + '</span>';
                        }
                    }
                },
                { 
                    field: 'ApprovedStatus', title: '审批状态' ,
                    formatter: function (value, row, index) {
                        if (row.ApprovedStatus == "@ApprovedStatusEnum.Approved.ParseToInt()") {
                            return '<span class="badge badge-primary">' + "@ApprovedStatusEnum.Approved.GetDescription()" + '</span>';
                        } else {
                            return '<span class="badge badge-warning">' + "@ApprovedStatusEnum.Unapproved.GetDescription()" + '</span>';
                        }
                    }
                },
                { field: 'InstanceId', title: 'InstanceId' , visible: false  },
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }

    function searchGrid() {
        $('#gridTable').ysTable('search');
        resetToolbarStatus();
    }

    function showSaveForm(bAdd) {
        var id = 0;
        if (!bAdd) {
            var selectedRow = $('#gridTable').bootstrapTable('getSelections');
            if (!ys.checkRowEdit(selectedRow)) {
                return;
            }
            else {
                id = selectedRow[0].Id;
            }
        }
        ys.openDialog({
            title: id > 0 ? '编辑' : '添加',
            content: '@Url.Content("~/InfoManage/AppointmentRecord/AppointmentRecordForm")' + '?id=' + id,
            width: '768px',
            height: '550px',
            callback: function (index, layero) {
                var iframeWin = window[layero.find('iframe')[0]['name']];
                iframeWin.saveForm(index);
            }
        });
    }

    function deleteForm() {
        var selectedRow = $('#gridTable').bootstrapTable('getSelections');
        if (ys.checkRowDelete(selectedRow)) {
            ys.confirm('确认要删除选中的' + selectedRow.length + '条数据吗？', function () {
                var ids = ys.getIds(selectedRow);
                ys.ajax({
                    url: '@Url.Content("~/InfoManage/AppointmentRecord/DeleteFormJson")' + '?ids=' + ids,
                    type: 'post',
                    success: function (obj) {
                        if (obj.Tag == 1) {
                            ys.msgSuccess(obj.Message);
                            searchGrid();
                        }
                        else {
                            ys.msgError(obj.Message);
                        }
                    }
                });
            });
        }
    }
</script>